      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bp_pipeline_latency_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
